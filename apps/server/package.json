{
  "name": "@coral/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "test:db": "docker exec -i coral-db psql -U coral -d coral -q < test/guards.sql",
    "test:e2e": "tsx test/e2e.ts"
  },
  "dependencies": {
    "@coral/agent": "workspace:*",
    "@coral/core": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
